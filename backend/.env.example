DATABASE_URL=postgresql://usuario:password@host:5432/railway
PORT=3000
FRONTEND_URL=https://tu-proyecto.netlify.app
JWT_SECRET=cambiar-por-un-secreto-seguro-de-32-chars-minimo
ADMIN_PASSWORD=cambiar-por-password-seguro

# Zona horaria del club. Define que dia es "hoy" para la caja, el dashboard y los
# reportes. Sin esto, con el club abierto de 15:00 a 00:00, a partir de las 21:00
# el servidor contaria todo en el dia siguiente.
CLUB_TZ=America/Argentina/Buenos_Aires

# PIN del primer usuario dueño que se crea solo la primera vez que arranca.
# Si no lo ponés, se crea con 1234 y hay que cambiarlo desde el panel (Personal).
PIN_DUENO=
NOMBRE_DUENO=Dueño

# Asistente del dueño (pestaña "Asistente"). Sin esta clave la pestaña avisa que
# no está configurado y el resto del sistema sigue igual.
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-opus-5-5)
ASISTENTE_MODELO=
